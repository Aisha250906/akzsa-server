# Copy this file to .env and fill in your own values.
# Never commit .env or put GROQ_API_KEY inside the Android APK.
AKZSA_ENV=development
LOG_LEVEL=INFO

# Get a key from the Groq console. Keep it server-side only.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Optional during local development. Set a long random value for shared deployments.
AKZSA_SERVER_TOKEN=

# --- Abuse controls (in-memory, single instance) ---
# AKZSA_RATE_COMMANDS_PER_MIN=30
# AKZSA_RATE_COMMANDS_PER_MIN_IP=90
# AKZSA_RATE_VOICE_PER_MIN=10
# AKZSA_RATE_VOICE_PER_MIN_IP=30
# AKZSA_MAX_CONCURRENT_PROVIDER_CALLS=8
